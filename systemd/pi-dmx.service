[Unit]
Description=Pi DMX Controller
After=network-online.target olad.service oled_splash.service
Wants=olad.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pi-dmx-controller-v2
Environment=PYTHONUNBUFFERED=1
Environment=DMX_UART_MIN_SLOTS=256

# === AUDIO SOURCE SELECTION ===
# Choose ONE of these configurations by uncommenting the appropriate block.
# Default in repo: USB. Use scripts/audio-source.sh to switch.
# V3: all 5 encoders are on the MCP23017 I2C expander, so audio source has no
# effect on encoders (the old I2S pin conflict no longer exists).

# --- OPTION A: HiFiBerry DAC+ ADC (I2S HAT) ---
Environment=AUDIO_INPUT_CHANNEL=left
Environment=AUDIO_DEVICE_NAME=hifiberry
Environment=DETECT_MODE=classic
# Fixed per-frequency gain curve: boost rises with the selected band center so mids (snare)
# / highs (hats) drive output as reliably as the kick — deterministic, no auto-locking.
Environment=AGC_GAIN_MODE=scaled

# --- OPTION B: USB Audio Interface ---
# Environment=AUDIO_INPUT_CHANNEL=right
# Environment=AUDIO_DEVICE_NAME=USB

ExecStart=/home/pi/pi-dmx-controller-v2/.venv/bin/python /home/pi/pi-dmx-controller-v2/dmx_audio_react.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
